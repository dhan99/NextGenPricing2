{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"],
      "@dealpad/domain": ["./packages/domain/src/index.ts"],
      "@dealpad/domain/*": ["./packages/domain/src/*"],
      "@dealpad/application": ["./packages/application/src/index.ts"],
      "@dealpad/application/*": ["./packages/application/src/*"],
      "@dealpad/infrastructure": ["./packages/infrastructure/src/index.ts"],
      "@dealpad/infrastructure/*": ["./packages/infrastructure/src/*"]
    }
  },
  "include": ["client/src/**/*", "server/**/*", "shared/**/*", "packages/*/src/**/*", "tests/**/*"]
}
